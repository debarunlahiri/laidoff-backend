NODE_ENV=development
HOST=127.0.0.1
PORT=9090
CORS_ORIGINS=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=laidoffcircle
DB_USER=laidoffcircle
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
# Managed/production Postgres usually requires TLS. Set DB_SSL_REJECT_UNAUTHORIZED=false only for self-signed certificates.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
SESSION_DAYS=7
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads
# Set only when requests come through a trusted reverse proxy.
TRUST_PROXY=false
# Required only for the optional development seed; choose your own password.
SEED_PASSWORD=

# API, application, SQL, and mutation audit logging (enabled by default).
LOGGING_ENABLED=true
LOG_OUTBOX_DIR=./.log-outbox
LOG_MAX_FIELD_CHARACTERS=16000
LOG_MAX_PAYLOAD_CHARACTERS=64000

# Email (Hostinger SMTP). Without SMTP_* set, emails are skipped and logged.
# Public frontend URL used in email links, e.g. https://laidoffcircle.com
APP_URL=http://localhost:3000
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=donot-reply@laidoffcircle.com
SMTP_PASSWORD=
MAIL_FROM_NAME=LayoffCircle
# MAIL_FROM=donot-reply@laidoffcircle.com   # defaults to SMTP_USER
EMAIL_VERIFICATION_HOURS=24
# Reminder emails for unverified accounts: first after N hours, then every M hours, at most MAX times.
VERIFICATION_REMINDERS_ENABLED=true
VERIFICATION_REMINDER_AFTER_HOURS=24
VERIFICATION_REMINDER_INTERVAL_HOURS=72
VERIFICATION_REMINDER_MAX=3

# Enable Google sign-in after creating a Firebase project.
FIREBASE_PROJECT_ID=
# Absolute path to a service-account JSON file kept outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Google Cloud (Agent Platform / Vertex AI) API key. Server-side only; never expose it to the browser.
# GOOGLE_CLOUD_API_KEY=

# Optional Google Maps URL signing secret. Server-side only; never expose it to the browser.
# GOOGLE_MAPS_URL_SIGNING_SECRET=

# One-time MySQL -> PostgreSQL data copy (npm run db:copy-from-mysql). Not used by the API.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=laidoff
# MYSQL_USER=laidoff
# MYSQL_PASSWORD=
