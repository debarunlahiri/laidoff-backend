# LOCAL development. Copy to .env (git-ignored) and fill in.
NODE_ENV=development
HOST=127.0.0.1
PORT=9090
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=laidoffcircle
DB_USER=laidoffcircle
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

SESSION_DAYS=7
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads

# Migrations run on start. Set AUTO_MIGRATE=false to opt out.
# AUTO_MIGRATE=true
# Detailed request/response console logs (set false to quiet them).
# HTTP_LOG_DETAIL=true
LOGGING_ENABLED=true
LOG_OUTBOX_DIR=./.log-outbox
LOG_MAX_FIELD_CHARACTERS=16000
LOG_MAX_PAYLOAD_CHARACTERS=64000

# Optional dev seed only; choose your own password.
SEED_PASSWORD=

# Google sign-in. Service-account JSON kept OUTSIDE the repository.
FIREBASE_PROJECT_ID=laidoffcircle
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
GOOGLE_CLOUD_API_KEY=
GOOGLE_MAPS_URL_SIGNING_SECRET=

# Email (Hostinger SMTP). Leave SMTP_HOST empty to skip sending in dev.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=donot-reply@laidoffcircle.com
SMTP_PASSWORD=
MAIL_FROM_NAME=LaidOffCircle

ADMIN_EMAILS=admin@laidoffcircle.com

# Old MySQL database: only for `npm run db:copy-from-mysql`.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_DATABASE=laidoff
# MYSQL_USER=laidoff
# MYSQL_PASSWORD=
