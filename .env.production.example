# PRODUCTION. Create as .env on the server (git-ignored). Never commit real values.
NODE_ENV=production
HOST=127.0.0.1                      # nginx/Caddy proxies to this
PORT=9090
CORS_ORIGINS=https://laidoffcircle.com,https://www.laidoffcircle.com
APP_URL=https://laidoffcircle.com   # links inside emails
TRUST_PROXY=true                    # required behind a reverse proxy

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=laidoffcircle
DB_USER=laidoffcircle
DB_PASSWORD=                        # strong, unique
DB_CONNECTION_LIMIT=10
DB_SSL=false                        # true for a remote/managed database
DB_SSL_REJECT_UNAUTHORIZED=true

SESSION_DAYS=7
UPLOAD_DIR=/var/www/laidoffcircle/uploads
PRIVATE_UPLOAD_DIR=/var/www/laidoffcircle/private-uploads

HTTP_LOG_DETAIL=false               # quieter production console
LOGGING_ENABLED=true
LOG_OUTBOX_DIR=/var/log/laidoffcircle/outbox
LOG_MAX_FIELD_CHARACTERS=16000
LOG_MAX_PAYLOAD_CHARACTERS=64000

# Google sign-in: service-account JSON outside the repo, readable only by the app user.
FIREBASE_PROJECT_ID=laidoffcircle
GOOGLE_APPLICATION_CREDENTIALS=/etc/laidoffcircle/serviceAccountKey.json
GOOGLE_CLOUD_API_KEY=
GOOGLE_MAPS_URL_SIGNING_SECRET=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=donot-reply@laidoffcircle.com
SMTP_PASSWORD=
MAIL_FROM_NAME=LaidOffCircle

ADMIN_EMAILS=admin@laidoffcircle.com
