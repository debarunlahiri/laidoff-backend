{
  "name": "laidoff-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:make": "node --env-file-if-exists=.env scripts/make-admin.js",
    "agent:key": "node --env-file-if-exists=.env scripts/agent-key.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:seed:community": "node --env-file-if-exists=.env scripts/seed-community.js",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --env-file-if-exists=.env scripts/check-schema.js",
    "db:copy-from-mysql": "node --env-file-if-exists=.env scripts/copy-mysql-to-postgres.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
